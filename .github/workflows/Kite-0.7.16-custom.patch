diff --git a/VelaCore/Sources/VelaCore/VignetteRoads.swift b/VelaCore/Sources/VelaCore/VignetteRoads.swift
new file mode 100644
index 0000000..6a8fd3d
--- /dev/null
+++ b/VelaCore/Sources/VelaCore/VignetteRoads.swift
@@ -0,0 +1,43 @@
+import Foundation
+
+public enum VignetteRoads {
+    /// Czech toll-tagged motorway sections whose mapped geometry agrees with the selected route.
+    /// This is positive-only: an empty response is never evidence that the drive is exempt.
+    public static func czechMotorways(on line: [LatLng]) async -> [String] {
+        guard line.count >= 2, line.contains(where: { (48.5...51.1).contains($0.lat) && (12...19).contains($0.lng) }) else { return [] }
+        let cumulative = Geo.cumulative(line)
+        var references = Set<String>()
+        let locale = Locale(identifier: "en_US_POSIX")
+        for piece in Overpass.pieces(line, meters: 70_000) {
+            guard !Task.isCancelled else { return [] }
+            let candidates = piece.filter { (48.5...51.1).contains($0.lat) && (12...19).contains($0.lng) }
+            guard candidates.count >= 2 else { continue }
+            let step = max(1, (candidates.count + 199) / 200)
+            let coordinates = (stride(from: 0, to: candidates.count, by: step).map { candidates[$0] } + [candidates[candidates.count - 1]])
+                .map { String(format: "%.5f,%.5f", locale: locale, $0.lat, $0.lng) }.joined(separator: ",")
+            let query = """
+            [out:json][timeout:14];
+            area["ISO3166-1"="CZ"]["admin_level"="2"]->.country;
+            way["highway"="motorway"]["toll"="yes"](area.country)(around:24,\(coordinates));
+            out body geom 300;
+            """
+            guard let data = await Overpass.firstAnswer(query, stagger: 4, valid: { elements($0) != nil }) else { continue }
+            for way in elements(data) ?? [] {
+                guard let ref = (way["tags"] as? [String: String])?["ref"], !ref.isEmpty,
+                      let geometry = way["geometry"] as? [[String: Double]] else { continue }
+                let points = geometry.compactMap { item -> LatLng? in
+                    guard let lat = item["lat"], let lng = item["lon"] else { return nil }
+                    return LatLng(lat, lng)
+                }
+                let hits = points.map { Geo.project($0, on: line, cumulative: cumulative) }
+                    .filter { $0.offset < 15 }.map(\.along)
+                if let low = hits.min(), let high = hits.max(), high - low > 150 { references.insert(ref) }
+            }
+        }
+        return references.sorted()
+    }
+
+    private static func elements(_ data: Data) -> [[String: Any]]? {
+        (try? JSONSerialization.jsonObject(with: data) as? [String: Any])?["elements"] as? [[String: Any]]
+    }
+}
